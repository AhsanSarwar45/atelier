#!/usr/bin/env bash
# The machinery's own gate: its refusals, and whether they would notice their
# own faults coming back.
#
# Every project that runs this board is held to `board/selftest.py` by its own
# compile gate. Nothing held the machinery to the other half — putting each
# fault back and watching a case go red — so thirty-odd faults stood only while
# somebody remembered to type the command (mch-mkp.55). This is that command.
#
# It is what the checks step of a job runs here — `machinery.toml` names it, and
# the step is the one place a job pays for it: once, in front of the reader,
# against everything the job built. No commit hook runs it. Held back per commit
# it was the same minutes over and over for a change nobody had finished making
# (bw-a6o.2).
#
# The reinjection is eleven of the twelve minutes this used to cost, and it can
# only ever say something about the gates themselves. Put in front of every
# change it charged that to jobs it could not have an opinion about: a release
# whose only code change was a version number waited it out twice, and an hour of
# the manager's afternoon went with it (bw-7lex.1). So it is asked for by what the
# tree actually changes — anything under `machinery/`, and it runs; nothing there,
# and it does not.
#
#   machinery/check              selftest, and the reinjection only if the gates moved
#   machinery/check --faults     the reinjection whatever the tree says
#   machinery/check --no-faults  never the reinjection, however the gates moved
#   machinery/check --say        print which of those two it would run, and stop
#
set -euo pipefail

FAULTS=auto
SAY=0
for said in "$@"; do
  case "$said" in
    --faults)    FAULTS=yes ;;
    --no-faults) FAULTS=no ;;
    --say)       SAY=1 ;;
    -h|--help)   sed -n '2,30p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) printf 'check: unknown option %s\n' "$said" >&2; exit 2 ;;
  esac
done

cd "$(dirname "$(readlink -f "$0")")"

# What is being judged is what a commit would contain — which, in front of a
# commit, is what is staged and not the commit behind it. `git write-tree` names
# that tree without touching the working tree or moving any ref.
#
# Asked FIRST, while the hook's own settings still stand: git tells a pre-commit
# hook which index the commit is being built from, and for `commit -a` or one
# naming paths that is a temporary index of its own. Clearing the pointer first
# asks the wrong index — whose lock the commit in progress is already holding, so
# the question fails outright (mch-mkp.64). Assigned on its own line rather than
# through `export`, so a failure stops the run instead of leaving no tree named.
if [ -z "${TREE:-}" ]; then
  TREE=$(git write-tree)
fi
export TREE

# And now they go. A commit here is made from a worktree, so these point INTO
# one, and every git command below would inherit them: the throwaway checkouts
# the cases build would never be built, and their commits and branches would land
# on the real repository instead (mch-mkp.56). The suite clears them for itself
# too; this is the same answer given at the door, for everything else run here.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_PREFIX

# Asked of the tree being judged, not of the working files: what a commit would
# contain is the same thing every case below is run against. Against the line the
# work lands on, because a job is judged by everything it changed and not by
# whatever its last commit happened to touch. No trunk to compare with — a fresh
# clone, a detached head — and the reinjection runs: not knowing is not a reason
# to skip the half that catches a gate going quiet.
gates_moved() {
  local trunk
  # In a checkout the project's declaration is the folder above this one. An
  # exported copy of this folder is run on its own with the declaration laid
  # beside it instead, and a copy with neither has no line to compare against —
  # the faults then go back rather than being skipped on a file that is not there.
  local said=../machinery.toml
  [ -f "$said" ] || said=./machinery.toml
  trunk=$(sed -n 's/^lands_on *= *"\([^"]*\)".*/\1/p' "$said" 2>/dev/null || true)
  [ -n "$trunk" ] || return 0
  git rev-parse -q --verify "refs/heads/$trunk" >/dev/null || return 0
  ! git diff --quiet "refs/heads/$trunk" "$TREE" -- . 2>/dev/null
}

if [ "$FAULTS" = auto ]; then
  if gates_moved; then FAULTS=yes; else FAULTS=no; fi
fi

if [ "$SAY" = 1 ]; then
  printf 'board/selftest.py\n'
  [ "$FAULTS" = yes ] && printf 'board/inject.py\n'
  printf 'voice-check.py\n'
  exit 0
fi

began=$SECONDS
python3 board/selftest.py

# Each fault is a whole suite run in a copy of its own, so this is minutes rather
# than one. That is why it is asked for only when the gates themselves are
# changing, and why another project's push runs the cheap half (`--anchors`).
if [ "$FAULTS" = yes ]; then
  python3 board/inject.py
else
  printf '\nthe gates did not move, so the faults were not put back — `machinery/check --faults` does that\n'
fi

# Where the gates are written down, and how they are spelled. Cheap, and it
# catches the two faults that cost the most for the least work: a gate spelled
# as one computer's folder, and a gate written down in two settings files so it
# runs twice on every turn (bw-nqll.3, bw-nqll.4).
python3 settings-lint.py --selftest
python3 settings-lint.py

# A picture never sits in the conversation (bw-nqll.1).
python3 hooks/picture-gate.py --selftest

# A file short enough to read whole is read whole, once (bw-nqll.2).
python3 hooks/slice-gate.py --selftest

# A search over a tree is run by the tool that reads the ignore list (bw-cp9o.1).
python3 hooks/search-gate.py --selftest

# That doorman is registered in the personal settings rather than this project's,
# because the habit it answers is the personal settings' own and every project on
# the computer pays for it (bw-2x54.2). So the copy that actually stands in front
# of a session is the installed one, and the cases above prove the one in the
# repository. This is the line between them. Asked only where the personal
# settings register it: a computer that has not put it up is not failed for a
# file it never asked for (bw-2x54.3).
worn=$HOME/.claude/hooks/search-gate.py
if grep -qF "$worn" "$HOME/.claude/settings.json" 2>/dev/null; then
  if ! cmp -s hooks/search-gate.py "$worn"; then
    printf '\nthe search doorman standing in front of every project is not the one in this repository\n' >&2
    printf '  install -m 755 %s/hooks/search-gate.py %s\n' "$PWD" "$worn" >&2
    exit 1
  fi
  printf 'the installed search doorman matches this one\n'
fi

# The files that teach an agent how to write are held to how we want it to write.
# An agent copies the register of its own prompt, so the instruction files are
# where the register is set and where it drifts back (bw-ld63).
python3 voice-check.py --selftest
python3 voice-check.py

printf 'checked in %ss\n' "$((SECONDS - began))"
