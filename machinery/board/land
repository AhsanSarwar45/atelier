#!/usr/bin/env python3
"""Put a step's finished work on the main line, and close what it carried.

    python3 board/land <card>          land the branch this tree is on
    python3 board/land <card> --dry    say what it would do and close nothing

Landing was four turns of a session's own — catch up, take the slot, merge, give
the slot back — around sixteen times a working day, and the slot came back four
times fewer than it went out in each of the two sessions measured (mch-aa9).
Four turns a session cannot skip is four turns that are not the work.

The closes were the same story one step further on: 968 of them by hand over 63
jobs, each its own turn and each its own board round trip past the gate that asks
whether a commit naming the card is on the main line. The landing has just put
those commits there and can read the answer straight off the merge, so it closes
every work item this landing carried and lets the run open the next step
(bw-aczr.3).

⛔ This runs the ritual; it does not replace it. The merge is the same
`git merge --ff-only` from the same slot holder that
`hooks/board-merge-gate.py` watches for, so a landing that would not
fast-forward is refused here exactly as it is refused by hand. The slot goes
back in a `finally`: the one thing worse than four turns is a slot nobody holds
and nobody can take.

The same goes for what the gate does around that merge. Its litter sweep reads
the command out of a session's Bash tool, and the merge here is made by a
subprocess of this script, which that tool never sees — so a landing run this
way would walk into the one refusal the sweep was built to stop, "Working
directory has staged changes", naming nobody. The gate's own `clear_the_way` is
called here instead of copied, so both spellings of a landing set the same
leftovers aside and refuse for the same live session by name (bw-a6o.3.6).
"""
import argparse
import importlib.machinery
import importlib.util
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
sys.path.insert(0, os.path.dirname(HERE))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "hooks"))
import board_common as bc  # noqa: E402
import project  # noqa: E402
import run as running  # noqa: E402


def _gate():
    """The merge gate, loaded by path: a hook's filename is not an identifier."""
    where = os.path.join(os.path.dirname(HERE), "hooks", "board-merge-gate.py")
    spec = importlib.util.spec_from_loader(
        "board_merge_gate",
        importlib.machinery.SourceFileLoader("board_merge_gate", where))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


gate = _gate()

ROOT = project.root(os.getcwd())
HERE_TREE = os.getcwd()
GIT_TIMEOUT = 300
# Long enough to queue behind another landing rather than give up on it. The
# hooks' own `bd` gives up after twenty seconds, which is right for a hook and
# turns `--wait` into a lie here (mch-aa9.11).
SLOT_TIMEOUT = 1800
# The same reasoning one notch down: a close is a write to the board and this is
# not a hook, so twenty seconds is a card left open on a slow board rather than a
# hook that hung.
BD_TIMEOUT = 120
# The label the work position's own items wear. The position has no card and
# these ARE it (board/spine.py); a step card of the same job wears `step:checks`
# or `step:land` instead.
WORK = "step:work"


def git(args, where, must=True):
    run = subprocess.run(["git"] + args, cwd=where, capture_output=True,
                         text=True, timeout=GIT_TIMEOUT)
    if must and run.returncode != 0:
        raise SystemExit("git %s: %s%s" % (args[0], run.stdout or "", run.stderr or ""))
    return (run.stdout or "").strip(), run.returncode


def me():
    """The board name this session holds things under.

    The same name `hooks/board-actor.py` stamps onto the session's own board
    commands, so the merge gate recognises the hold as this session's. Taken
    under bd's default instead, the slot would be held by a name every session
    on this machine shares, and the guard that catches a slot left behind could
    never fire (mch-aa9.12).
    """
    return bc.actor(os.environ.get("CLAUDE_CODE_SESSION_ID"), HERE_TREE)


def slot(verb):
    """Ask the board for the merge slot, under this session's own name."""
    run = subprocess.run(["bd", "merge-slot", verb, "--actor", me()]
                         + (["--wait"] if verb == "acquire" else []),
                         cwd=ROOT, capture_output=True, text=True,
                         timeout=SLOT_TIMEOUT)
    return run.returncode == 0, (run.stdout or "") + (run.stderr or "")


def board(args):
    """Run a board command and hand back everything it said, refusals and all.

    `board_common.bd` throws stderr away, and a close the board turns down says
    why only there. A landing that swallowed that would close some of a job's
    items, skip the rest and never say which.
    """
    try:
        run = subprocess.run(["bd"] + args, cwd=ROOT, capture_output=True,
                             text=True, timeout=BD_TIMEOUT)
    except Exception as died:
        return False, str(died)
    return run.returncode == 0, ((run.stdout or "") + (run.stderr or "")).strip()


def job_of(cid):
    """The goal this card belongs to.

    What its `of:` label names, or the card itself when the card IS the goal: a
    step and a work item both carry that label, and a goal carries none because
    there is nothing above it to name.
    """
    card = running.card(cid, ROOT)
    if card is None:
        # Not a card with no label: read as one, a board hiccup landed against the
        # card's own id and closed nothing, with nothing said (bw-aczr.16).
        sys.exit("the board did not answer for %s, so nothing can say which job this "
                 "landing is for. Try again, and if the board is down that is the "
                 "thing to fix first." % cid)
    return next((l[3:] for l in card.get("labels") or [] if l.startswith("of:")), cid)


def items_of(goal_id):
    """The job's work items that are still open, in the order they were poured."""
    return [r for r in running.children(goal_id, ROOT)
            if WORK in (r.get("labels") or [])
            and r.get("status") in ("open", "in_progress")]


def steps_open(goal_id):
    """The job's step cards standing open right now, by id.

    Only so the landing can say what it opened: the run hands the next step out
    itself and answers with a refusal or nothing, never with the card it made.
    """
    return {r["id"]: r for r in running.children(goal_id, ROOT)
            if r.get("status") not in ("closed", "cancelled")
            and any(l.startswith("step:") and l != WORK
                    for l in r.get("labels") or [])}


def merged(where, span):
    """Every commit in this span, as (short sha, subject, the whole message)."""
    out, _ = git(["log", "--format=%h%x1f%s%x1f%b%x1e", span], where)
    made = []
    for block in out.split("\x1e"):
        sha, _, rest = block.strip().partition("\x1f")
        subject, _, body = rest.partition("\x1f")
        if sha:
            made.append((sha, subject, "%s\n%s" % (subject, body)))
    return made


def carried_by(item_id, made):
    """The commit of this landing whose SUBJECT names this item, if one does.

    The subject is where this repo says what a commit finished, one card or
    several — "bw-8dp8.1 bw-8dp8.2 bw-8dp8.3: a Git view in the chat rail" — and
    the body is where it explains itself. Prose explains itself by naming
    siblings, and a name in prose is a mention, not a claim of completion. Read
    over the whole message it closed bw-8jzg.6 on the landing of bw-8jzg.7, whose
    body said four times which LATER card would take a temporary allowance back
    off again ("this allowance comes off with bw-8jzg.6"); the card closed with
    none of its own work written (bw-sykg.1).

    On a word boundary, the way every other reader of a message reads an id: a
    commit naming `x-j.31` does not land `x-j.3`.
    """
    # A dot is a word boundary, so without the lookahead a commit naming only a
    # child item (tst-j.1.2) read as naming its parent (tst-j.1) too (bw-aczr.10).
    named = re.compile(r"\b%s\b(?!\.\d)" % re.escape(item_id))
    return next((c for c in made if named.search(c[1])), None)


def what_landed(goal_id, where, span):
    """The job's open work items this landing put on the main line, each with
    the commit that carries it.

    Narrower than the close gate on every count, because a `bd` run from a
    subprocess never reaches that gate and a check that is looser than the gate
    is the gate switched off. Only a WORK ITEM, never a step card of the job. And
    only one whose OWN id the SUBJECT of a commit of THIS landing names, where
    the gate would also take the name of the step above it
    (hooks/board-status-gate.py, `landing_names`), would take that name from
    anywhere in the message, and would look at the whole of the main line rather
    than at what just went onto it.

    The one thing the gate asks that is not asked here is the page: a work item
    is carried by its job's page, the steps and the goal above it still close by
    hand through that gate, and a landing that stopped to refuse over a page
    would send every one of these items back to being closed by hand.
    """
    made = merged(where, span)
    found = []
    for row in items_of(goal_id):
        commit = carried_by(row["id"], made)
        if commit:
            found.append((row["id"], commit[0], commit[1]))
    return found


def close_landed(goal_id, found, actor):
    """Close each of these items and let the run open whatever comes next.

    968 closes by hand over 63 jobs, each one a turn of a session's own and a
    board round trip with its own gate in front of it. The landing already knows
    which commits went in and every one of them names the item it carries, so it
    is the one place that can close them without asking anybody anything
    (bw-aczr.3).

    A close the board turns down is said out loud and the rest still go: the
    assignee may be this same session under another folder's name, and one item
    the board will not have is no reason to leave the others open.
    """
    closed, refused = [], []
    for item, sha, subject in found:
        ok, said = board(["close", item, "--reason",
                          "landed at %s: %s" % (sha, subject), "--actor", actor])
        if ok:
            closed.append((item, sha))
        else:
            refused.append((item, said))
    if not closed:
        return closed, refused, [], ""
    was = steps_open(goal_id)
    # The run is what opens the next position and hands it over, exactly as it
    # does behind a close typed by hand (hooks/board-touch.py). This landing is a
    # subprocess of the session's own tool call, which that hook never sees, so
    # nothing else here would move the job on.
    said = running.advance(closed[-1][0], ROOT, actor, HERE_TREE)
    fresh = [row for cid, row in steps_open(goal_id).items() if cid not in was]
    return closed, refused, fresh, said or ""


def tree():
    """The checkout this command is standing in, and the branch it is on."""
    top, _ = git(["rev-parse", "--show-toplevel"], HERE_TREE)
    branch, _ = git(["rev-parse", "--abbrev-ref", "HEAD"], top)
    return top, branch


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("card", help="the card whose work this branch carries")
    ap.add_argument("--dry", action="store_true",
                    help="say what it would merge and close, and do neither")
    a = ap.parse_args()

    top, branch = tree()
    main_tree, trunk = bc.landings(ROOT, a.card)[0]
    if os.path.realpath(top) == os.path.realpath(main_tree):
        sys.exit("land is run from the tree holding the work, not from %s itself"
                 % main_tree)
    if branch == trunk:
        sys.exit("%s is the main line: land is run from the branch carrying the work"
                 % branch)

    # A branch that never names the card is somebody else's work, and landing it
    # under this card is how a card closes on a change nobody wrote for it.
    named, _ = git(["log", "--format=%H", "-E", "--grep", r"\b%s\b" % a.card,
                    "%s..%s" % (trunk, branch)], top)
    if not named.split():
        sys.exit("no commit on %s names %s: land the card whose work this branch "
                 "carries" % (branch, a.card))

    if a.dry:
        print("would land %d commit(s) of %s from %s onto %s in %s"
              % (len(named.split()), a.card, branch, trunk, main_tree))
        would = what_landed(job_of(a.card), top, "%s..%s" % (trunk, branch))
        if would:
            print("would close %d work item(s): %s"
                  % (len(would), ", ".join("%s at %s" % (i, s) for i, s, _ in would)))
        else:
            print("would close nothing: no open work item of this job is named by a "
                  "commit that would land")
        return

    # The merge happens in the main checkout, into whatever that checkout is
    # standing on — so a main tree left on somebody else's branch would be
    # fast-forwarded instead, and this would report that the main line moved
    # (mch-aa9.19).
    standing, _ = git(["rev-parse", "--abbrev-ref", "HEAD"], main_tree)
    if standing != trunk:
        sys.exit("%s is standing on %s, not on %s: put it back before landing, or "
                 "the wrong branch is what moves" % (main_tree, standing, trunk))

    git(["rebase", trunk], top)
    took, out = slot("acquire")
    if not took:
        sys.exit("could not take the merge slot: %s" % out.strip())
    landed, blocked, was = False, "", ""
    try:
        # Inside the slot, so no other landing is sweeping the same checkout at
        # the same moment, and before the merge, because leftovers are what the
        # merge would die on.
        said, refused = gate.clear_the_way(ROOT, trunk)
        if refused:
            # Carried to the exit rather than said here: the refusal already
            # names the live session and every file it holds, and printing it
            # now put that whole block on the screen twice for one failure
            # (bw-a6o.3.11).
            blocked = said
        else:
            if said:
                print(said)
            # Where the main line stood before this landing, so the commits that
            # went in can be read back off it afterwards. Taken inside the slot:
            # outside it another landing could move the trunk between the reading
            # and the merge, and this landing would then close that one's items.
            was, _ = git(["rev-parse", "HEAD"], main_tree)
            _, code = git(["merge", "--ff-only", branch], main_tree, must=False)
            landed = code == 0
    finally:
        gave, why = slot("release")

    # Said in this order because a slot nobody can take stops every landing on
    # this machine, and a landing that says it worked while holding it is how
    # nobody finds out (mch-aa9.13).
    if not gave:
        sys.exit("⛔ the merge slot is STILL HELD and no other landing can run "
                 "until it is freed — `bd merge-slot release --actor %s`: %s"
                 % (me(), why.strip()))
    if blocked:
        sys.exit("nothing was merged and the slot is free again: %s" % blocked)
    if not landed:
        sys.exit("%s would not fast-forward onto %s even after catching up; "
                 "the slot is free again" % (branch, trunk))

    head, _ = git(["rev-parse", "--short", "HEAD"], main_tree)
    print("landed %d commit(s) of %s: %s is now %s"
          % (len(named.split()), a.card, trunk, head))

    # Said after the landing itself and never in its place: the merge is the one
    # thing that must be reported whatever the board does next, and a board that
    # is down must not turn a landing that worked into a landing that failed.
    goal = job_of(a.card)
    found = what_landed(goal, main_tree, "%s..HEAD" % was) if was else []
    if not found:
        return
    closed, refused, fresh, held_back = close_landed(goal, found, me())
    if closed:
        print("closed %d work item(s) of %s: %s"
              % (len(closed), goal,
                 ", ".join("%s at %s" % (cid, sha) for cid, sha in closed)))
    for item, why in refused:
        print("%s stayed open: %s" % (item, why))
    for row in fresh:
        print("opened %s %s, held by %s"
              % (row.get("id"), row.get("title") or "", row.get("assignee") or "nobody"))
    if held_back:
        print(held_back)
    left = items_of(goal)
    if left and not fresh:
        print("%s still has %d work item(s) open: %s"
              % (goal, len(left), ", ".join(r["id"] for r in left)))


if __name__ == "__main__":
    main()
