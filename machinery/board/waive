#!/usr/bin/env python3
"""Takes the board off this session, on the manager's word.

He waives it now and then — a one-line change, a question about the tooling, a
thing that is not a piece of work at all — and pouring a job for those spends
his attention on bookkeeping he has just said he does not want. The board still
owns every run he has not spoken about: this is his exemption, not the session's,
so it is refused without the words he said it in, and it says them back at every
gate it opens.

One session's, never the machine's. `hooks/board_common.py` keys it on the
session id, so a waiver given here leaves every refusal standing in a session
he never spoke to. It expires on its own (`board_common.WAIVER_KEEP`).

    waive "<what he said>"   take the board off this session
    waive --off              put it back
    waive --status           say where it stands
"""
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                "..", "hooks"))
import board_common as bc  # noqa: E402

# What the gates stand aside for, named here so the refusal a session reads and
# the record on disk cannot say two different things.
GATES = "workflow-gate.py, board-gate.py, board-status-gate.py"


def die(message):
    print(message, file=sys.stderr)
    raise SystemExit(2)


def session():
    sid = (os.environ.get("CLAUDE_CODE_SESSION_ID")
           or os.environ.get("CODEX_SESSION_ID"))
    if not sid:
        die("No session to waive: neither CLAUDE_CODE_SESSION_ID nor "
            "CODEX_SESSION_ID is set. A waiver is one session's, so there is "
            "nothing to write it against.")
    return sid


def main():
    args = sys.argv[1:]
    sid = session()
    path = bc.waiver_path(sid)

    if args[:1] == ["--status"]:
        row = bc.waived(sid)
        if not row:
            print("Board on. Every refusal stands.")
            return
        print("Board waived for this session, on his words: %s" % row.get("words"))
        print("Standing aside: %s" % GATES)
        print("Expires %d minutes from when it was given (%s)."
              % (bc.WAIVER_KEEP // 60, path))
        return

    if args[:1] == ["--off"]:
        try:
            os.remove(path)
        except FileNotFoundError:
            pass
        print("Board on. Every refusal stands.")
        return

    words = " ".join(args).strip()
    if not words:
        die('A waiver carries the manager\'s own words, and there are none here.\n'
            'A session does not waive its own board: quote what he said.\n'
            '    waive "no beads required for this"')

    os.makedirs(bc.STATE_DIR, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump({"words": words, "t": bc.now(), "session": sid}, fh)
    os.replace(tmp, path)
    print("Board waived for this session, on his words: %s" % words)
    print("Standing aside: %s" % GATES)
    print("Back on with `waive --off`, or by itself in %d minutes."
          % (bc.WAIVER_KEEP // 60))


if __name__ == "__main__":
    main()
