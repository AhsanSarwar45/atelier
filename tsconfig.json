{
  "compilerOptions": {
    // The runtime everything here actually runs on: the browser build, and Node
    // 22 reading the sidecar's TypeScript as it stands. Left unsaid, tsc checks
    // against ES5 — which reports `for (const x of aSet)` as an error in every
    // file the sidecar has, and hid a real one behind them (bw-sxzv.3).
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Some files under src/workbench are read twice: once by the browser's
    // build and once by the chat's own server, which is Node running the
    // TypeScript as it stands. Node resolves the exact filename or nothing, so
    // those files name theirs (bw-7ks.22.35).
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `workbench` was here, and while it was, nothing typechecked the chat's own
  // server at all: a null handed to a rule that measures a string went out and
  // killed a live conversation before anyone read a type error, because there
  // was no run that could have printed one (bw-sxzv).
  "exclude": ["node_modules", "tests", "playwright.config.ts", "worktrees"]
}
