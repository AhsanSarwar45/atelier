/issues.jsonl

# spec and test files
SPEC.md
test-*.md
test-*.txt
.verification_logs/

# Git worktrees
.worktrees/
Vent

# Claude Code project config. The working rules ship with the clone — the gates,
# the workers, the skills and the house voice — so a fresh checkout behaves the
# way the team does. What is one person's own machine does not.
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/commands/
!.claude/output-styles/
!.claude/skills/

# IDE/tool artifacts
.history/
.playwright-mcp/
agentform/

# Extra build targets
/server/target2/

# Dolt server runtime files
.dolt/
.doltcfg/
.dolt_dropped_databases/
config.yaml
beads_*/

# Compiled binaries
atelier-linux-*
atelier-win-*
atelier-darwin-*

# Reports are a person's own work and live in the data folder, never here.
reporting/pages/

# Python bytecode from the report builder
__pycache__/
*.pyc

# Agent workbench (docs/agent-workbench.md)
/workbench/node_modules
# E2E run artifacts: every spec's own instance data dir and fixture project,
# the browser's output folder, and the marker a run drops recording how it went.
# The screenshots at tests/results/*.png are evidence and stay tracked.
/tests/.*-run*/
/tests/.artifacts/
/test-results/

worktrees/

# Beads / Dolt files (added by bd init)
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# The machine's own list of which checkouts run this machinery. `machinery/join`
# writes it and it is never the same on two computers; `machinery/projects.toml.example`
# is the one that ships.
/machinery/projects.toml

# The dev server's own log, one machine's running notes.
/.dev-*.log
