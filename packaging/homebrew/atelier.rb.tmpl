class Atelier < Formula
  desc "Visual board and multi-project dashboard for tracked work"
  homepage "https://github.com/AhsanSarwar45/atelier"
  version "__VERSION__"
  license "MIT"

  # Chat is implemented in the Rust program, so Node is neither a dependency nor
  # a payload hidden inside this package.

  on_macos do
    on_arm do
      url "https://github.com/AhsanSarwar45/atelier/releases/download/v__VERSION__/atelier-darwin-arm64.tar.gz"
      sha256 "__ARM_SHA__"
    end
    on_intel do
      url "https://github.com/AhsanSarwar45/atelier/releases/download/v__VERSION__/atelier-darwin-x64.tar.gz"
      sha256 "__INTEL_SHA__"
    end
  end

  on_linux do
    on_intel do
      url "https://github.com/AhsanSarwar45/atelier/releases/download/v__VERSION__/atelier-linux-x64.tar.gz"
      sha256 "__LINUX_SHA__"
    end
  end

  def install
    bin.install "atelier"
  end

  def caveats
    <<~EOS
      Three commands, and nothing else to start:

        atelier run              start everything and open the board
        atelier service install  have this computer start it at login
        atelier init             set the project in this folder up on it

      It answers your whole network, so the board opens on your phone —
      starting it prints the address to type there.

      The Chat tab is part of Atelier itself, so you need neither Node nor npm.

      Project tracking needs git and the Beads CLI (bd):
        https://github.com/gastownhall/beads

      None of these has to be on your PATH. Atelier looks there first, then in
      the ordinary places an installer writes to, which is how the copy started
      at login finds them with no shell behind it.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/atelier --version")
  end
end
