class Atelier < Formula
  desc "Visual board and multi-project dashboard for tracked work"
  homepage "https://github.com/AhsanSarwar45/atelier"
  version "__VERSION__"
  license "MIT"

  # No `depends_on "node"`, and now for a stronger reason than before: the
  # archive carries its own Node runtime beside the program, so the Chat tab
  # needs nothing installed for it. Depending on node would have Homebrew install
  # and link its own ahead of whatever node manager the reader already runs —
  # which is how most people who have node have it — and quietly change which
  # node their other work is built with, for a runtime this no longer uses.

  on_macos do
    on_arm do
      url "https://github.com/AhsanSarwar45/atelier/releases/download/v__VERSION__/atelier-darwin-arm64.tar.gz"
      sha256 "__ARM_SHA__"
    end
    on_intel do
      url "https://github.com/AhsanSarwar45/atelier/releases/download/v__VERSION__/atelier-darwin-x64.tar.gz"
      sha256 "__INTEL_SHA__"
    end
  end

  on_linux do
    on_intel do
      url "https://github.com/AhsanSarwar45/atelier/releases/download/v__VERSION__/atelier-linux-x64.tar.gz"
      sha256 "__LINUX_SHA__"
    end
  end

  def install
    # The archive carries the program and its Node runtime side by side. Both go
    # into libexec together so they stay siblings, and a relative symlink puts
    # the program on the PATH; the program follows that link back to itself and
    # finds node right beside it (bw-oesd.2).
    libexec.install "atelier", "node"
    bin.install_symlink libexec/"atelier"
  end

  def caveats
    <<~EOS
      Three commands, and nothing else to start:

        atelier run              start everything and open the board
        atelier service install  have this computer start it at login
        atelier init             set the project in this folder up on it

      It answers your whole network, so the board opens on your phone —
      starting it prints the address to type there.

      The Chat tab carries its own Node runtime, so you need neither Node nor npm
      installed for it — the board, the screens, and the chat all work as they
      come.

      `init` needs python 3.11+ and the Beads CLI (bd):
        https://github.com/gastownhall/beads

      None of these has to be on your PATH. Atelier looks there first, then in
      the ordinary places an installer writes to, which is how the copy started
      at login finds them with no shell behind it.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/atelier --version")
  end
end
