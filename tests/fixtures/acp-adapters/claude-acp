#!/usr/bin/env node
/**
 * An ACP agent that answers `session/list`, `session/load` and one asking turn.
 *
 * The point of it is that it is not Claude. This app's claim is that external
 * chats are discovered and replayed over ACP, so the case that proves the claim
 * must be able to put a chat on screen with no provider record anywhere on the
 * disk — a chat that exists only because an agent said so on the wire
 * (bw-t26l.22).
 *
 * Two pages, so the cursor is followed rather than assumed.
 */
const { spawn, spawnSync } = require('node:child_process');
const { existsSync, writeFileSync } = require('node:fs');
const { join } = require('node:path');
const readline = require('node:readline');

const MISSING_CODEX_ROLLOUT = process.env.BEADS_E2E_ACP_MISSING_ROLLOUT === '1'
  && !process.env.CLAUDE_CODE_EXECUTABLE;

function providerModels() {
  const provider = process.env.CLAUDE_CODE_EXECUTABLE ?? process.env.CODEX_PATH;
  if (!provider) return ['fixture-model-one', 'fixture-model-two'];
  const run = spawnSync(provider, ['--atelier-fixture-models'], { encoding: 'utf8' });
  if (run.status !== 0) return ['fixture-model-one', 'fixture-model-two'];
  try {
    const models = JSON.parse(run.stdout);
    if (Array.isArray(models) && models.every((model) => typeof model === 'string') && models.length) return models;
  } catch {}
  return ['fixture-model-one', 'fixture-model-two'];
}

function configOptions(current) {
  const models = providerModels();
  const selected = models.includes(current) ? current : models[0];
  return [{
    id: 'model', name: 'Model', category: 'model', type: 'select', currentValue: selected,
    options: models.map((value) => ({ value, name: value })),
  }];
}

const PAGES = (cwd) => ({
  first: {
    sessions: [
      {
        sessionId: 'acp-session-one',
        cwd,
        title: 'A chat only ACP knows about',
        updatedAt: '2026-09-02T05:00:02.000Z',
      },
      ...(MISSING_CODEX_ROLLOUT ? [{
        sessionId: 'acp-session-missing-rollout',
        cwd,
        title: 'A Codex chat whose rollout is gone',
        updatedAt: '2026-09-02T05:10:02.000Z',
      }] : []),
    ],
    nextCursor: 'page-two',
  },
  'page-two': {
    sessions: [
      {
        sessionId: 'acp-session-two',
        cwd,
        title: 'The chat on the second page',
        updatedAt: '2026-09-02T04:00:02.000Z',
      },
      {
        sessionId: 'acp-session-long',
        cwd,
        title: 'A very long chat over ACP',
        updatedAt: '2026-09-02T03:00:02.000Z',
      },
    ],
  },
});

/**
 * A chat with a thousand turns in it, said the way an agent says one: as a
 * stream of `session/update` notifications during the load.
 *
 * Nothing about the wire changes with length, which is the point — what a long
 * one is for is the reading end. A cost that is quadratic in the number of
 * updates is invisible on the two-line chats above and is the whole of "they
 * take ages to load" on a real one.
 */
const LONG_TURNS = 1_000;
const LAST_LONG = `and that is the last answer over ACP, ${LONG_TURNS}`;
function longReplay() {
  const said = [];
  for (let turn = 1; turn <= LONG_TURNS; turn += 1) {
    said.push(['user_message_chunk', `question number ${turn}`]);
    said.push([
      'agent_message_chunk',
      turn === LONG_TURNS ? LAST_LONG : `answer number ${turn}, with enough words in it to be a real reply`,
    ]);
  }
  return said;
}

/**
 * What the client answered when this agent asked it something mid-load.
 *
 * A replay connection is still a connection: the handshake promises `fs`,
 * `terminal` and `elicitation`, and an agent that takes the client at its word
 * may ask any of them at any point — an agent that needs to be signed in asks
 * exactly here, before it can hand over a single line of history. What it must
 * never get is `method_not_found` for a capability it was just promised
 * (bw-t26l.22).
 */
const answers = new Map();
const waiting = new Map();
function ask(message) {
  return new Promise((resolve) => {
    waiting.set(message.id, resolve);
    say(message);
  });
}

const REPLAY = {
  'acp-session-one': [
    ['user_message_chunk', 'What did the second page say?'],
    ['agent_message_chunk', 'The first chat answered over ACP.'],
  ],
  'acp-session-two': [
    ['user_message_chunk', 'And this one?'],
    ['agent_message_chunk', 'The second chat answered over ACP.'],
  ],
  'acp-session-missing-rollout': [
    ['user_message_chunk', 'Can this saved chat continue?'],
    ['agent_message_chunk', 'Its transcript is still readable.'],
  ],
};

/**
 * A chat that holds more memory than it is allowed to. Set
 * `BEADS_E2E_MEMORY_HOG` to a number of megabytes and `BEADS_E2E_MEMORY_MARKER`
 * to a path, and the first agent started spawns a child that touches that much
 * and keeps it. The child is deliberately a grandchild of the app rather than
 * this process, because the claim being proved is that a chat is charged for
 * everything below it, not only for the agent itself.
 *
 * The marker file makes it happen once. The agent this chat is restarted with
 * must come back lean, or the limit would stop it again and again and the case
 * could never read the transcript it is there to read (bw-qg8r.1).
 */
function holdTooMuchMemory() {
  const megabytes = Number(process.env.BEADS_E2E_MEMORY_HOG ?? 0);
  const marker = process.env.BEADS_E2E_MEMORY_MARKER;
  if (!megabytes || !marker || existsSync(marker)) return;
  writeFileSync(marker, String(process.pid));
  const child = spawn(
    process.execPath,
    ['-e', `const held = Buffer.alloc(${megabytes} * 1024 * 1024, 7); setInterval(() => held[0]++, 1000);`],
    { stdio: 'ignore', detached: false },
  );
  child.unref();
}

holdTooMuchMemory();

function say(message) {
  process.stdout.write(`${JSON.stringify({ jsonrpc: '2.0', ...message })}\n`);
}

readline.createInterface({ input: process.stdin }).on('line', (line) => {
  let message;
  try {
    message = JSON.parse(line);
  } catch {
    return;
  }
  const { id, method, params } = message;
  if (method === undefined && id !== undefined && waiting.has(id)) {
    const settle = waiting.get(id);
    waiting.delete(id);
    settle(message);
    return;
  }
  // The spec's own cancel, the one notification this agent answers: the turn
  // it names ends as `cancelled`, and the agent stays for the next prompt.
  if (method === 'session/cancel') {
    const open = openTurns.get(params?.sessionId);
    if (open !== undefined) endTurn(open, params.sessionId, 'cancelled');
    return;
  }
  if (id === undefined) return;
  if (method === 'initialize') {
    say({
      id,
      result: {
        protocolVersion: 1,
        agentCapabilities: {
          loadSession: true,
          promptCapabilities: {},
          sessionCapabilities: {
            list: {},
            ...(MISSING_CODEX_ROLLOUT ? { resume: {} } : {}),
          },
        },
        authMethods: [],
      },
    });
    return;
  }
  if (method === 'session/list') {
    const pages = PAGES(params?.cwd ?? process.cwd());
    say({ id, result: pages[params?.cursor ?? 'first'] ?? { sessions: [] } });
    return;
  }
  if (method === 'session/load') {
    void load(id, params);
    return;
  }
  if (method === 'session/new') {
    started += 1;
    const sessionId = `acp-session-new-${process.pid}-${started}`;
    selectedModels.set(sessionId, undefined);
    say({ id, result: { sessionId, configOptions: configOptions() } });
    return;
  }
  if (method === 'session/resume') {
    if (params?.sessionId === 'acp-session-missing-rollout') {
      say({
        id,
        error: {
          code: -32603,
          message: `Internal error: {"details":"no rollout found for thread id ${params.sessionId}"}`,
        },
      });
      return;
    }
    say({ id, result: { sessionId: params?.sessionId, configOptions: configOptions() } });
    return;
  }
  if (method === 'session/set_config_option') {
    const sessionId = params?.sessionId;
    if (params?.configId === 'model') selectedModels.set(sessionId, params?.value);
    say({ id, result: { configOptions: configOptions(selectedModels.get(sessionId)) } });
    return;
  }
  if (method === 'session/prompt') {
    openTurns.set(params?.sessionId, id);
    void turn(id, params);
    return;
  }
  // A line the reader sends while a turn is running is steered into it, the
  // way the real adapter takes one. The agent answers at once and reads the
  // line out after the turn's own reply, so the screen shows it arrived.
  if (method === '_session/steering') {
    const text = (params?.prompt ?? []).map((block) => block?.text ?? '').join('');
    steered.set(params?.sessionId, [...(steered.get(params?.sessionId) ?? []), text]);
    say({ id, result: {} });
    return;
  }
  say({ id, error: { code: -32601, message: `no ${method} here` } });
});

async function load(id, params) {
    // The one clock ACP has for a session, sent the way an agent reports it:
    // on its own, with no rename beside it.
    if (params?.sessionId === 'acp-session-one') {
      say({
        method: 'session/update',
        params: { sessionId: params.sessionId, update: { sessionUpdate: 'session_info_update', updatedAt: '2026-09-02T05:31:00.000Z' } },
      });
    }
    // The second chat is the one that asks. Whatever comes back is said out
    // loud in the transcript, so the screen shows what the client answered.
    if (params?.sessionId === 'acp-session-two' && !answers.has(params.sessionId)) {
      const reply = await ask({
        id: 9001, method: 'elicitation/create',
        params: {
          mode: 'form',
          sessionId: params.sessionId,
          message: 'Sign in before this history can be read',
          requestedSchema: {
            type: 'object',
            properties: { ok: { type: 'boolean', description: 'Signed in' } },
            required: ['ok'],
          },
        },
      });
      answers.set(params.sessionId, reply.error ? `error ${reply.error.code}` : `action ${reply.result?.action}`);
    }
    const said = params?.sessionId === 'acp-session-long' ? longReplay() : (REPLAY[params?.sessionId] ?? []);
    const answered = answers.get(params?.sessionId);
    if (answered) {
      say({
        method: 'session/update',
        params: { sessionId: params.sessionId, update: { sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: `the client answered the mid-load question with ${answered}` } } },
      });
    }
    for (const [sessionUpdate, text] of said) {
      say({
        method: 'session/update',
        params: { sessionId: params.sessionId, update: { sessionUpdate, content: { type: 'text', text } } },
      });
    }
    say({ id, result: { configOptions: configOptions() } });
}

/**
 * The one turn this agent takes: it asks the reader a question, and then it
 * thinks.
 *
 * The silence after the answer is the whole of it. An agent that speaks the
 * instant it is answered hides the bug, because the update it sends carries a
 * state of its own and clears the line either way; a real one goes away and
 * works, and for as long as it does the only state on the record is the one
 * written when the question was asked (bw-qrgl.1).
 */
const QUIET_MS = Number(process.env.BEADS_E2E_ACP_QUIET_MS ?? 20_000);
let started = 0;
let asking = 9100;

/**
 * The turn each session has open, so a cancel can end it the way the spec
 * asks: the open `session/prompt` answered `cancelled`, and nothing said for
 * that turn after it (bw-fhyi).
 */
const openTurns = new Map();
function endTurn(id, sessionId, stopReason) {
  if (openTurns.get(sessionId) !== id) return;
  openTurns.delete(sessionId);
  say({ id, result: { stopReason } });
}
const stillOpen = (id, sessionId) => openTurns.get(sessionId) === id;

/**
 * A command that runs for minutes, the way a test suite does, and a line that
 * is answered at once. The two are what sending a message into a running
 * command is about: the first is what the message must stop, the second is
 * how the screen shows the message was read (bw-fhyi).
 */
const LONG_COMMAND = 'run the long command';
const LONG_COMMAND_MS = Number(process.env.BEADS_E2E_ACP_LONG_COMMAND_MS ?? 180_000);
const SAY_YOU_READ = 'say you read this';

async function longCommand(id, params) {
  const sessionId = params?.sessionId;
  const send = (update) => say({ method: 'session/update', params: { sessionId, update } });
  const toolCallId = `long-command-${id}`;
  // Its process named, so a case can tell the agent that answers next is this
  // one and not a fresh one started after Stop's kind of ending.
  // Each reply carries its own message ID, as the real adapter's do: this
  // loads a scripted history, not the chat's, so generated IDs would start
  // again after Stop and draw over the chat's first reply.
  send({
    sessionUpdate: 'agent_message_chunk', messageId: `running-${id}-${process.pid}`,
    content: { type: 'text', text: `Running the tests in agent ${process.pid}.` },
  });
  send({
    sessionUpdate: 'tool_call', toolCallId, title: 'npx playwright test', kind: 'execute',
    status: 'in_progress', rawInput: { command: 'npx playwright test' },
  });
  await new Promise((settle) => setTimeout(settle, LONG_COMMAND_MS));
  if (!stillOpen(id, sessionId)) return;
  send({ sessionUpdate: 'tool_call_update', toolCallId, status: 'completed' });
  endTurn(id, sessionId, 'end_turn');
}
const selectedModels = new Map();
const steered = new Map();

async function dropOnceWithOwnedProvider(sessionId) {
  const sentinel = process.env.BEADS_E2E_ACP_DROP_ONCE;
  if (!sentinel || existsSync(sentinel)) return false;
  const holder = spawn(process.execPath, [join(__dirname, 'owned-provider-holder.cjs'), sessionId], {
    detached: true,
    env: process.env,
    stdio: 'ignore',
  });
  holder.unref();
  const marker = join(process.env.CLAUDE_CONFIG_DIR, 'sessions', `${holder.pid}.json`);
  const until = Date.now() + 2_000;
  while (!existsSync(marker) && Date.now() < until) {
    await new Promise((settle) => setTimeout(settle, 10));
  }
  writeFileSync(sentinel, `${holder.pid}\n`);
  // Break the ACP stream without cleaning up the provider, reproducing the
  // production failure where the driver vanished but Claude stayed alive.
  process.exit(86);
}

/**
 * The two ways an adapter has of saying the chat is folding itself up.
 *
 * ACP's compaction kinds are unstable, so the adapters in the wild disagree.
 * Codex's sends the real thing; the one shipped for Claude has nowhere to put a
 * fold and says it in the agent's own voice, a beat at a time, which the app
 * used to append to whatever sentence was open. Both are scripted here so one
 * case can prove they draw the same (bw-ryh3).
 */
const FOLD = 'fold this up';
const OLD_WAY = 'the old way';
/** How long the scripted fold is held open, so the screen can be read mid-fold. */
const FOLD_MS = Number(process.env.BEADS_E2E_ACP_FOLD_MS ?? 4_000);

async function fold(id, params, inWords) {
  const sessionId = params?.sessionId;
  const send = (update) => say({ method: 'session/update', params: { sessionId, update } });
  const words = (text) => send({ sessionUpdate: 'agent_message_chunk', content: { type: 'text', text } });

  // The sentence the fold must not land in the middle of.
  words('Let me follow the existing spec’s shape.');

  if (inWords) {
    // Verbatim what the shipped claude-acp emits, one beat per status tick.
    const beats = Math.max(1, Math.round(FOLD_MS / 1000));
    for (let beat = 0; beat < beats; beat += 1) {
      words('Compacting...');
      await new Promise((settle) => setTimeout(settle, FOLD_MS / beats));
    }
    words('\n\nCompacting completed.');
  } else {
    send({ sessionUpdate: 'compaction_update', compactionId: 'fold-1', status: 'in_progress' });
    send({
      sessionUpdate: 'compaction_summary_chunk',
      compactionId: 'fold-1',
      content: { type: 'text', text: 'They were working on the board.' },
    });
    await new Promise((settle) => setTimeout(settle, FOLD_MS));
    send({ sessionUpdate: 'compaction_update', compactionId: 'fold-1', status: 'completed' });
  }

  words(' Now a test to hold it.');
  endTurn(id, sessionId, 'end_turn');
}

async function turn(id, params) {
  // A fold, asked for by name. Every other prompt takes the question turn
  // below, so no case written before this one changes.
  const asked = (params?.prompt ?? []).map((block) => block?.text ?? '').join('');
  if (asked.includes(FOLD)) {
    await fold(id, params, asked.includes(OLD_WAY));
    return;
  }
  if (asked.includes(LONG_COMMAND)) {
    await longCommand(id, params);
    return;
  }
  if (asked.includes(SAY_YOU_READ)) {
    say({
      method: 'session/update',
      params: {
        sessionId: params?.sessionId,
        update: {
          sessionUpdate: 'agent_message_chunk', messageId: `read-${id}-${process.pid}`,
          content: { type: 'text', text: `Agent ${process.pid} read: ${asked}` },
        },
      },
    });
    endTurn(id, params?.sessionId, 'end_turn');
    return;
  }
  if (MISSING_CODEX_ROLLOUT) {
    say({
      method: 'session/update',
      params: {
        sessionId: params.sessionId,
        update: {
          sessionUpdate: 'agent_message_chunk',
          content: { type: 'text', text: 'The replacement Codex thread answered.' },
        },
      },
    });
    endTurn(id, params?.sessionId, 'end_turn');
    return;
  }
  if (await dropOnceWithOwnedProvider(params?.sessionId)) return;
  asking += 1;
  const reply = await ask({
    id: asking,
    method: 'elicitation/create',
    params: {
      mode: 'form',
      sessionId: params?.sessionId,
      message: 'Prompt for the passphrase in the UI',
      requestedSchema: {
        type: 'object',
        properties: {
          direction: {
            type: 'string',
            title: 'Direction',
            enum: ['Prompt for the passphrase in the UI', 'Read it from the environment'],
          },
        },
        required: ['direction'],
      },
    },
  });
  // Answered, and now away working. Nothing is said for as long as that lasts.
  await new Promise((settle) => setTimeout(settle, QUIET_MS));
  if (!stillOpen(id, params?.sessionId)) return;
  const chosen = reply.result?.content?.direction ?? reply.result?.action ?? 'nothing';
  say({
    method: 'session/update',
    params: {
      sessionId: params?.sessionId,
      update: {
        sessionUpdate: 'agent_message_chunk',
        content: { type: 'text', text: `the reader answered the question with ${chosen}` },
      },
    },
  });
  for (const text of steered.get(params?.sessionId) ?? []) {
    say({
      method: 'session/update',
      params: {
        sessionId: params?.sessionId,
        update: { sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: ` and then read ${text}` } },
      },
    });
  }
  steered.delete(params?.sessionId);
  endTurn(id, params?.sessionId, 'end_turn');
}
