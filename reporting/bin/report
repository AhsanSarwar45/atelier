#!/usr/bin/env bash
# Build a manager report page. Runs from any project; the project it is about is
# the directory it was called from, so the pictures a spec names resolve there.
#
#   report new <slug>                 start a spec for the current project
#   report <slug>                     build it; prints the link to hand over
#   report open <slug>                build it and open it in the browser
#   report list                       every spec, newest project first
#   report check                      the gates, on their own
#
# A slug is enough — the spec is found under any project. A page is never
# published anywhere: the link the build prints is the whole delivery.
#
# Every build runs the gates first (57 ms), so a broken rule costs the next
# report rather than going unnoticed until someone runs the checks by hand.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
TOOLS="$HERE/tools"
PAGES="$HERE/pages"

project_name() {
  local root
  root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  basename "$root"
}

# A slug, a file name or a path all reach the same spec.
resolve_spec() {
  local want="$1"
  if [ -f "$want" ]; then echo "$want"; return; fi
  local hits
  hits="$(find "$PAGES" -name "$want.report.json" -o -name "$want" | head -3)"
  case "$(echo "$hits" | grep -c .)" in
    0) echo "no spec called '$want' — report list" >&2; exit 1 ;;
    1) echo "$hits" ;;
    *) echo "'$want' matches more than one spec:" >&2; echo "$hits" >&2; exit 1 ;;
  esac
}

gates() {
  python3 "$TOOLS/selftest.py" >/dev/null 2>&1 || {
    echo "the report gates are red — no report is built until they hold:" >&2
    python3 "$TOOLS/selftest.py" >&2 2>&1
    exit 1
  }
}

case "${1:-}" in
  list)
    find "$PAGES" -name "*.report.json" -printf "%T@ %p\n" | sort -rn | cut -d' ' -f2-
    ;;
  new)
    [ $# -ge 2 ] || { echo "report new <slug>" >&2; exit 2; }
    dir="$PAGES/$(project_name)"
    mkdir -p "$dir"
    dest="$dir/$2.report.json"
    [ -e "$dest" ] && { echo "already there: $dest" >&2; exit 1; }
    cp "$TOOLS/spec-template.report.json" "$dest"
    echo "$dest"
    ;;
  open)
    [ $# -ge 2 ] || { echo "report open <slug>" >&2; exit 2; }
    gates
    spec="$(resolve_spec "$2")"
    line="$(python3 "$TOOLS/build.py" "$spec" --project "$(pwd)")"
    echo "$line"
    xdg-open "${line%% *}" >/dev/null 2>&1 &
    ;;
  check)
    exec python3 "$TOOLS/selftest.py"
    ;;
  ""|-h|--help)
    sed -n '2,15p' "$0" | cut -c3-
    ;;
  *)
    gates
    spec="$(resolve_spec "$1")"
    shift
    exec python3 "$TOOLS/build.py" "$spec" "$@" --project "$(pwd)"
    ;;
esac
