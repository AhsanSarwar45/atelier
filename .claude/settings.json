{
  "autoCompactWindow": 200000,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "atelier hook workflow-gate.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "atelier hook board-actor.py"
          },
          {
            "type": "command",
            "command": "atelier hook board-merge-gate.py"
          },
          {
            "type": "command",
            "command": "atelier hook board-status-gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|AskUserQuestion|ExitPlanMode|Agent|Task|Monitor|TaskCreate|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "atelier hook board-touch.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "atelier hook doing"
          }
        ]
      }
    ],
    "SessionStart": [{ "matcher": "", "hooks": [{ "type": "command", "command": "atelier hook board-prime.py" }] }],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "atelier hook board-touch.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "atelier hook board-push.py"
          },
          {
            "type": "command",
            "command": "atelier hook doing"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "atelier hook completion-gate.py"
          },
          {
            "type": "command",
            "command": "atelier hook board-gate.py"
          },
          {
            "type": "command",
            "command": "atelier hook doing"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "atelier hook doing"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "atelier hook doing"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "atelier hook doing"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "atelier hook doing"
          }
        ]
      }
    ]
  }
}
