{
  "outputStyle": "manager",
  "autoCompactWindow": 200000,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Skill",
        "hooks": [
          { "type": "command", "command": "/home/ahsan/dev/machinery/hooks/agent-fence.py" }
        ]
      },
      {
        "matcher": "Artifact",
        "hooks": [
          { "type": "command", "command": "/home/ahsan/dev/beads-web/reporting/tools/publish-gate.py" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "/home/ahsan/dev/machinery/hooks/board-actor.py" },
          { "type": "command", "command": "/home/ahsan/dev/machinery/hooks/board-merge-gate.py" },
          { "type": "command", "command": "/home/ahsan/dev/machinery/hooks/board-status-gate.py" }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "/home/ahsan/dev/machinery/hooks/report-gate.py" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "/home/ahsan/dev/machinery/hooks/plan-doc-lint.py" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|AskUserQuestion|ExitPlanMode|Agent|Task|Monitor|TaskCreate|SendMessage",
        "hooks": [
          { "type": "command", "command": "/home/ahsan/dev/machinery/hooks/board-touch.py" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "/home/ahsan/dev/machinery/hooks/board-touch.py" },
          { "type": "command", "command": "/home/ahsan/dev/machinery/hooks/helper-proof.py" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "/home/ahsan/dev/machinery/hooks/habit-reading.py" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "/home/ahsan/dev/machinery/hooks/board-prime.py" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "/home/ahsan/dev/machinery/hooks/board-push.py" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "/home/ahsan/dev/machinery/hooks/completion-gate.py" },
          { "type": "command", "command": "/home/ahsan/dev/machinery/hooks/board-gate.py" }
        ]
      }
    ]
  }
}
