{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command|shell_command|functions.exec_command|apply_patch|functions.apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "atelier hook workflow-gate"
          }
        ]
      },
      {
        "matcher": "Bash|exec_command|shell_command|functions.exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "atelier hook board-actor"
          },
          {
            "type": "command",
            "command": "atelier hook board-merge-gate"
          },
          {
            "type": "command",
            "command": "atelier hook board-status-gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|exec_command|shell_command|functions.exec_command|apply_patch|functions.apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "atelier hook board-touch"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "atelier hook board-touch",
            "type": "command"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PostCompact",
            "statusMessage": "Scheduling Beads context refresh",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PreCompact",
            "statusMessage": "Checking Beads context",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "atelier hook board-prime"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "atelier hook board-gate"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "atelier hook board-push"
          }
        ]
      }
    ]
  }
}
