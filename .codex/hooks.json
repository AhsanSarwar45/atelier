{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "command": "atelier hook workflow-gate",
            "statusMessage": "Checking ticket worktree",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "atelier hook board-actor",
            "type": "command"
          },
          {
            "command": "atelier hook board-merge-gate",
            "statusMessage": "Checking protected branches",
            "type": "command"
          },
          {
            "command": "atelier hook board-status-gate",
            "statusMessage": "Checking board lifecycle",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "command": "atelier hook board-touch",
            "type": "command"
          },
          {
            "command": "atelier hook doing",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "command": "atelier hook doing", "type": "command" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "atelier hook board-touch.py",
            "type": "command"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PostCompact",
            "statusMessage": "Scheduling Beads context refresh",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PreCompact",
            "statusMessage": "Checking Beads context",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd codex-hook SessionStart",
            "statusMessage": "Loading Beads context",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ]
  }
}
