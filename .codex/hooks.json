{
  "hooks": {
    "PreToolUse": [
      { "matcher": "spawn_agent", "hooks": [{ "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/machinery/hooks/agent-fence.py\"" }] },
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "command": "python3 \"$(git rev-parse --show-toplevel)/machinery/hooks/workflow-gate.py\"",
            "statusMessage": "Checking ticket worktree",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "python3 \"$(git rev-parse --show-toplevel)/machinery/hooks/board-actor.py\"",
            "type": "command"
          },
          {
            "command": "python3 \"$(git rev-parse --show-toplevel)/machinery/hooks/board-merge-gate.py\"",
            "statusMessage": "Checking protected branches",
            "type": "command"
          },
          {
            "command": "python3 \"$(git rev-parse --show-toplevel)/machinery/hooks/board-status-gate.py\"",
            "statusMessage": "Checking board lifecycle",
            "type": "command"
          }
        ]
      },
      { "matcher": "request_user_input", "hooks": [{ "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/machinery/hooks/report-gate.py\"" }] },
      { "matcher": "apply_patch|Edit|Write", "hooks": [{ "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/machinery/hooks/plan-doc-lint.py\"" }] },
      { "matcher": "view_image", "hooks": [{ "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/machinery/hooks/picture-gate.py\"" }] },
      { "matcher": "Bash|view_image", "hooks": [{ "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/machinery/hooks/slice-gate.py\"" }] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/machinery/hooks/wait-gate.py\"" }] }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "command": "python3 \"$(git rev-parse --show-toplevel)/machinery/hooks/board-touch.py\"",
            "type": "command"
          },
          {
            "command": "python3 \"$(git rev-parse --show-toplevel)/machinery/hooks/helper-proof.py\"",
            "type": "command"
          },
          {
            "command": "python3 \"$(git rev-parse --show-toplevel)/workbench/hooks/session-doing.py\"",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "command": "bd codex-hook UserPromptSubmit", "statusMessage": "Refreshing Beads context", "type": "command" },
          { "command": "python3 \"$(git rev-parse --show-toplevel)/workbench/hooks/session-doing.py\"", "type": "command" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "python3 \"$(git rev-parse --show-toplevel)/machinery/hooks/board-touch.py\"",
            "type": "command"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PostCompact",
            "statusMessage": "Scheduling Beads context refresh",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PreCompact",
            "statusMessage": "Checking Beads context",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd codex-hook SessionStart",
            "statusMessage": "Loading Beads context",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ]
  }
}
