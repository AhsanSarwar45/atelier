#!/usr/bin/env python3
"""Move cards from one project's board to another's, whole.

A card lives on the board of the checkout whose files its fix changes. When a
project's tools move out — or a subject turns out to belong to somebody else —
the cards have to follow, and the first time that happened the plan was to edit
them by hand. Two hundred is not a hand job, and there will be a third time.

What "whole" means, and each of these is a way a hand-run move goes wrong:

  everything the card says   title, body, notes, close reason, tags, priority,
                             kind, who made it and when
  the family comes too       a card with children is a container; the children
                             are pulled in whether or not they were named
  links stay live            a link between two moved cards is rewritten to
                             their new ids; a link to a card staying behind
                             cannot exist across boards, so it becomes a line
                             in the body naming the old id
  ids in the prose           an id of a moved card mentioned in a body or a
                             note is rewritten too, so a trail does not break
  nothing in flight moves    a card somebody is holding stays where it is and
                             is named on the way out
  the old one is not deleted it is cancelled, carrying its new id, so the trail
                             from the old number still arrives

    board/move --to <project> <id> …      move these, and their families
    board/move --to <project> --dry-run … say what it would do, touch nothing

Ids are given in the source board's spelling. The source is the project the
first id's prefix belongs to.
"""
import argparse
import json
import os
import subprocess
import sys

HOME = os.path.dirname(os.path.realpath(os.path.dirname(os.path.realpath(__file__))))
sys.path.insert(0, HOME)
import project  # noqa: E402

# A card somebody is working is not a card to move: the session holding it has a
# tree, a branch and a commit message with that id in it. `deferred` is not held
# — it is work put off, and it travels.
HELD = ("in_progress",) + project.REVIEW_STATES

# Every status that means the board still counts the card as work to be done.
LIVE = HELD + ("open", "blocked", "deferred", "pinned", "hooked")


def bd(args, root, feed=None):
    out = subprocess.run(["bd", *args], cwd=root, input=feed,
                         capture_output=True, text=True)
    if out.returncode:
        sys.exit("bd %s in %s: %s" % (args[0], root, (out.stderr or out.stdout).strip()))
    return out.stdout


def cards(root):
    """Every card on this board, by id."""
    said = {}
    for line in bd(["export"], root).splitlines():
        if not line.strip():
            continue
        row = json.loads(line)
        if row.get("_type") == "issue" and row.get("id"):
            said[row["id"]] = row
    return said


def family(ids, all_cards):
    """The given cards and every descendant of them.

    A card with open children is a container and cannot be claimed, so a family
    split across two boards is a job nobody can finish on either.
    """
    kids = {}
    for cid, row in all_cards.items():
        for lab in row.get("labels") or []:
            if lab.startswith("of:"):
                kids.setdefault(lab[3:], []).append(cid)
    want, seen = list(ids), set()
    while want:
        cid = want.pop()
        if cid in seen or cid not in all_cards:
            continue
        seen.add(cid)
        want.extend(kids.get(cid, ()))
    return seen


def renamed(cid, src_prefix, dst_prefix):
    """`cor-oa6p.5` under prefix `mch` -> `mch-oa6p.5`. The suffix is what the
    board hands out and what every commit message already carries, so it is the
    half that must not change."""
    return dst_prefix + cid[len(src_prefix):] if cid.startswith(src_prefix + "-") else cid


def rewrite(text, mapping):
    """Every moved id spelled inside a piece of prose, in its new spelling.

    Longest first: `cor-oa6p.5` must not be rewritten as `cor-oa6p` plus a
    dangling `.5`.
    """
    if not text:
        return text
    for old in sorted(mapping, key=len, reverse=True):
        text = text.replace(old, mapping[old])
    return text


def carry(row, mapping, dst_prefix):
    """One card as the destination board should hold it."""
    out = dict(row)
    out["id"] = mapping[row["id"]]
    for field in ("title", "description", "notes", "design", "acceptance_criteria",
                  "close_reason"):
        if out.get(field):
            out[field] = rewrite(out[field], mapping)
    out["labels"] = [rewrite(l, mapping) for l in (row.get("labels") or [])]

    kept, lost = [], []
    for dep in row.get("dependencies") or []:
        other = dep.get("depends_on_id")
        if other in mapping:
            kept.append({**dep, "issue_id": mapping[dep["issue_id"]],
                         "depends_on_id": mapping[other]})
        elif other:
            lost.append((other, dep.get("type") or "related"))
    out["dependencies"] = kept
    if lost:
        # A link cannot cross two boards, so it becomes a sentence. The old id is
        # what the other board still calls that card, which is what makes it
        # findable at all.
        said = "; ".join("%s (%s)" % (o, t) for o, t in lost)
        out["notes"] = ((out.get("notes") or "") +
                        "\n\nLinked, before this card moved boards, to cards that "
                        "stayed behind: %s. A link cannot cross two boards; the ids "
                        "are the ones that board still uses." % said).strip()
    return out


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("ids", nargs="+", help="cards to move, in the source board's spelling")
    ap.add_argument("--to", required=True, help="the registered project to move them to")
    ap.add_argument("--dry-run", action="store_true",
                    help="say what it would do and touch nothing")
    a = ap.parse_args()

    dst = project.named(a.to)
    if not dst:
        sys.exit("no project called %s is registered — %s"
                 % (a.to, ", ".join(sorted(project.registry())) or "none are"))
    src_prefix = a.ids[0].split("-")[0]
    src = next((project.of(p) for p in project.registry().values()
                if project.of(p).prefix == src_prefix), None)
    if not src:
        sys.exit("no registered project hands out ids beginning %s-" % src_prefix)
    if src.prefix == dst.prefix:
        sys.exit("%s and %s are the same board" % (src.name, dst.name))

    here = cards(src.path)
    unknown = [i for i in a.ids if i not in here]
    if unknown:
        sys.exit("not on the %s board: %s" % (src.name, ", ".join(unknown)))

    whole = family(a.ids, here)
    held = sorted(c for c in whole if here[c].get("status") in HELD)
    going = sorted(whole - set(held))
    if held:
        print("staying — somebody is holding these right now:")
        for cid in held:
            print("    %-16s %-14s %s" % (cid, here[cid].get("status"),
                                          (here[cid].get("assignee") or "-")))
    if not going:
        sys.exit("nothing to move: every card named is being held.")

    mapping = {c: renamed(c, src.prefix, dst.prefix) for c in going}
    theirs = cards(dst.path)
    clash = sorted(n for n in mapping.values() if n in theirs)
    if clash:
        sys.exit("the %s board already holds: %s" % (dst.name, ", ".join(clash)))

    print("moving %d card(s) from %s to %s:" % (len(going), src.name, dst.name))
    for cid in going:
        print("    %-16s -> %-16s %s" % (cid, mapping[cid], here[cid]["title"][:60]))
    if a.dry_run:
        print("\ndry run — nothing was written to either board.")
        return 0

    feed = "\n".join(json.dumps(carry(here[c], mapping, dst.prefix)) for c in going)
    bd(["import", "-"], dst.path, feed=feed + "\n")

    landed = cards(dst.path)
    missing = sorted(n for n in mapping.values() if n not in landed)
    if missing:
        sys.exit("the import did not land %d card(s) — nothing was cancelled here, "
                 "so both boards still hold them: %s" % (len(missing), ", ".join(missing)))

    # Only once every card is standing on the other board: a cancel before the
    # import lands is a card that exists nowhere.
    tool = project.tool(src, "job")
    for cid in going:
        why = "moved to %s on the %s board" % (mapping[cid], dst.name)
        out = subprocess.run([sys.executable, tool, "cancel", cid, "--reason=" + why],
                             cwd=src.path, capture_output=True, text=True)
        if out.returncode:
            # A card a dead session still has its name on refuses to close for
            # anyone else. The session is gone — the hold is not somebody working.
            subprocess.run(["bd", "update", cid, "--assignee", ""],
                           cwd=src.path, capture_output=True, text=True)
            subprocess.run([sys.executable, tool, "cancel", cid, "--reason=" + why],
                           cwd=src.path, capture_output=True, text=True)

    # A cancel that quietly did nothing leaves the card open on both boards, which
    # is the one outcome a move must never have: two boards each say the work is
    # theirs and neither knows about the other.
    after = cards(src.path)
    standing = sorted(c for c in going if after[c].get("status") in LIVE)
    if standing:
        sys.exit("%d card(s) landed on the %s board but would not close here, so "
                 "they stand open on both: %s" % (len(standing), dst.name,
                                                  ", ".join(standing)))
    print("\n%d card(s) are on the %s board and cancelled here, each carrying its new id."
          % (len(going), dst.name))
    return 0


if __name__ == "__main__":
    sys.exit(main())
