#!/usr/bin/env python3
"""Write a rewritten section onto a card already standing, held to the same bar.

The sweep (cor-dlby) rewrites 221 cards that were poured before the bars
existed. Every one of those rewrites goes through here, because a sweep allowed
to write whatever it likes finishes by putting 221 fresh sentences that mean
nothing onto the board — which is the fault it was sent to fix.

    python3 board/sweep rewrites.json          write them
    python3 board/sweep rewrites.json --dry    say what it would write

The file is {card id: {section: the new words}}, sections named as
`board/sections.py` names them: what, evidence, done, not_in, where.
A job's `what` is its title as well — the pour writes one line into both, and a
card whose title and first line disagree is a card nobody can search for.

⛔ Refused whole. One rewrite below the bar refuses the file, so a half-written
batch never reaches the board. See docs/board.md#4e-what-a-section-has-to-carry.
"""
import argparse
import json
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
sys.path.insert(0, os.path.dirname(HERE))
import plain  # noqa: E402
import project  # noqa: E402
import sections  # noqa: E402

ROOT = project.root(os.getcwd())
sections.use(ROOT)

# Which bar each section answers to, and which of them a card of that kind has.
BAR = {"what": lambda t: sections.what_is_wrong(t),
       "done": lambda t: sections.finish_line(t),
       "not_in": lambda t: sections.left_out(t),
       "where": lambda t: sections.where_it_is(t),
       "evidence": lambda t: ("" if len(t.strip()) >= 20 else
                              "Evidence it is real must say what makes this real "
                              "today: the check that went red and its number, the "
                              "image, or the manager's words.")}
HAS = {"job": ("what", "evidence", "done", "not_in"), "find": ("what", "where"),
       "item": ("what", "done")}


def bd(args, capture=True):
    out = subprocess.run(["bd"] + args, cwd=ROOT, capture_output=capture, text=True)
    if out.returncode != 0:
        sys.exit("bd %s failed: %s" % (args[0], (out.stderr or out.stdout).strip()))
    return out.stdout or ""


def card(cid):
    """One card. `bd show --json` answers with a list of the cards it was asked for."""
    got = json.loads(bd(["show", cid, "--json"]))
    return got[0] if isinstance(got, list) else got


def body(card, kind, new):
    """The card's description with each rewritten section put back in its place.

    Matched by heading rather than by the old words: a card poured on one day
    carries a blank line under its headings and one poured on another does not,
    and a rewrite that quietly matched neither would report itself written.
    """
    text = card.get("description") or ""
    for name, words in new.items():
        head = sections.HEADINGS.get(name)
        if not head or kind == "item":
            continue
        block = "## %s\n%s\n" % (head, words.strip())
        text, hit = re.subn(r"^##\s+%s\s*$.*?(?=^##\s|\Z)" % re.escape(head),
                            block.replace("\\", "\\\\"), text, count=1,
                            flags=re.M | re.S)
        if not hit:
            text = text.rstrip("\n") + "\n\n" + block
    return text


def refusals(cid, kind, new):
    """Every reason this card's rewrite may not be written."""
    said = []
    for name, words in new.items():
        if name not in HAS[kind]:
            said.append("%s: a %s has no %s section" % (cid, kind, name))
            continue
        problem = BAR[name](words)
        if problem:
            said.append("%s, %s: %s" % (cid, name, problem))
    if "what" in new:
        try:
            found = plain.problems(new["what"])
        except plain.Unreadable as exc:
            sys.exit("nothing has been written: the shared word list would not load "
                     "(%s), and a check that could not run is not a check that "
                     "passed" % exc)
        if found:
            said.append("%s, what: the new line is still in the words of whoever "
                        "built the thing: %s" % (cid, "; ".join(found)))
    return said


def write(cid, kind, new, card_now):
    """The bd arguments that put this rewrite on the card, or nothing to write."""
    args = ["update", cid]
    if "what" in new:
        args += ["--title", new["what"]]
    if "done" in new:
        args += ["--acceptance", new["done"]]
        if kind == "job":
            args += ["--set-metadata", "done=" + new["done"]]
    text = body(card_now, kind, new)
    if text != (card_now.get("description") or ""):
        args += ["-d", text]
    return args if len(args) > 2 else []


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("file", help="{card id: {section: the new words}}")
    ap.add_argument("--dry", action="store_true", help="say what it would write")
    a = ap.parse_args()

    rewrites = json.load(open(a.file))
    cards = {cid: card(cid) for cid in rewrites}
    said = []
    for cid, new in rewrites.items():
        kind = sections.kind_of(cards[cid])
        if kind == "step":
            said.append("%s is a step the board wrote for itself, and the sweep does "
                        "not touch those (cor-tg56)" % cid)
            continue
        said += refusals(cid, kind, new)
    if said:
        sys.exit("nothing has been written — %d of these rewrites is below the bar "
                 "the pour holds a new card to:\n\n%s" % (len(said), "\n\n".join(said)))

    for cid, new in rewrites.items():
        kind = sections.kind_of(cards[cid])
        args = write(cid, kind, new, cards[cid])
        if not args:
            sys.exit("%s asked for %s and nothing would change, so the rewrite is "
                     "landing nowhere — the card's body is not shaped the way this "
                     "reads it" % (cid, ", ".join(sorted(new))))
        if a.dry:
            print("%s would take %s" % (cid, ", ".join(sorted(new))))
            continue
        bd(args)
        left = sections.faults(card(cid), plain.problems)
        still = [n for n in new if n in left or (n == "what" and "title" in left)]
        if still:
            sys.exit("%s was written and is still below the bar on %s, so the bar the "
                     "sweep checks and the bar the board reads have come apart"
                     % (cid, ", ".join(still)))
        print("%s took %s" % (cid, ", ".join(sorted(new))))


if __name__ == "__main__":
    main()
